# /etc/clusterd.conf: the installer's settings for clusterd (software/linux/README.md).
# The settings the dial changes (theme, units, ...) live in /var/lib/clusterd/settings.conf and win over
# anything repeated here.

# private link to gauges/: the device-tree name of Verdin CAN_1, 500 kbit/s (set with ip link)
can_if = can1

# the car (sent to gauges/ in DisplaySettings, SpeedCalibration and InputConfig)
car_profile = 1            # 0 none, 1 Haltech V2
car_bitrate = 1            # 0 500k, 1 1M, 2 250k
tank_capacity_l = 60       # placeholder: the owner's real tank (PLAN.md open question)
pulses_per_mile = 16000    # AutoMeter 16-pulse sender at 1000 rev/mile
lamp_invert_mask = 0       # bit 0..5 turn L, turn R, high beam, brake, alternator, oil: 1 = ground-switched
tach_enabled = 0
tach_pulses_per_rev = 4    # V8, points or wasted spark

# the dial (Piher PSC-360 on ADC_1): counts at 0 and just under 360 degrees, detents per turn
dial_raw_min = 0
dial_raw_max = 4095
dial_detents = 24

# LIVI
livi_port = 4000
page_port = 4010
map_shape_cmd = python3 /usr/share/clusterd/livi_config.py --apply /home/cluster/.config/LIVI/config.json

# Key off (software/linux/README.md): gauges/ counts down, then clusterd arms the RTC and suspends. If the car is still
# parked when the time is up it powers off, and brain/'s latch drops the board to microamps; the next key on is a cold
# boot. Both commands need polkit's permission for the cluster user (deploy/50-clusterd-power.rules).
suspend_cmd = systemctl suspend
poweroff_cmd = systemctl poweroff
parked_poweroff_hours = 48  # decimals work (0.05 is 3 minutes, for bring-up), up to 720; 0 = no alarm, never power off
# The RTC that can wake the module: rtc1, the System Manager's, in mainline's imx95-verdin.dtsi. rtc0 there is the
# on-module RX8130, which has no interrupt wired and so no wakealarm file. Check on the module (L6).
rtc_wakealarm = /sys/class/rtc/rtc1/wakealarm
