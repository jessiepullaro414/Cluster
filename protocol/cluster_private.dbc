 SG_ Counter : 52|4@1+ (1,0) [0|15] "" GAUGES
 SG_ Crc8 : 56|8@1+ (1,0) [0|255] "" GAUGES

CM_ BO_ 768 "Consolidated motion data, chosen by gauges/ from the Hall input and the car bus.";
CM_ BO_ 770 "Consolidated fluid data: ECU value if fresh, else local sender.";
CM_ BO_ 771 "Indicator-lamp states from the six 12 V lamp inputs on gauges/ (1 = lamp on after the per-channel polarity setting), sent every 100 ms and on every change.";
CM_ BO_ 769 "Health, identity and where each value currently comes from.";
CM_ BO_ 784 "Ignition and sleep coordination; also sent on every change.";
CM_ BO_ 1024 "Persistent settings owned by Android; sent on change and every second. gauges/ keeps the last copy in flash.";
CM_ BO_ 1040 "Pulses per mile for the Hall sender (AutoMeter 16-pulse sender at 1000 rev/mile = 16000).";
CM_ BO_ 1056 "Per-input options for the lamp and tach inputs on gauges/. A lamp wired ground-switched (the DNP pull-up fitted) idles high, so its bit here is set to invert it.";
CM_ BO_ 1264 "Liveness plus coarse state; gauges/ marks the display offline if this stops.";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GenMsgCycleTime" BO_ 768 50;
BA_ "GenMsgCycleTime" BO_ 770 100;
BA_ "GenMsgCycleTime" BO_ 771 100;
BA_ "GenMsgCycleTime" BO_ 769 1000;
BA_ "GenMsgCycleTime" BO_ 784 500;
BA_ "GenMsgCycleTime" BO_ 1024 1000;
BA_ "GenMsgCycleTime" BO_ 1040 1000;
BA_ "GenMsgCycleTime" BO_ 1056 1000;
BA_ "GenMsgCycleTime" BO_ 1264 1000;
