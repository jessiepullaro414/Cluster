<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Development feed of the vehicle state to the PC (UDP, see TelemetryPublisher). Not needed in
         the car, where the data comes from the gauges board over CAN. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Cluster"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
        android:supportsRtl="false">

        <!-- Launchable by hand now; the HOME category makes it selectable as the
             launcher, which is how the production image will start it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:screenOrientation="nosensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
